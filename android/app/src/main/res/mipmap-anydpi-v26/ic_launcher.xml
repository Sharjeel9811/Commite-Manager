<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon (API 26+).

  The mark is drawn as two PNG layers generated by `tool/generate_icons.dart`
  rather than as a vector, so the launcher and the Play listing icon come from
  exactly the same source. `monochrome` reuses the foreground for Android 13+
  themed icons.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
