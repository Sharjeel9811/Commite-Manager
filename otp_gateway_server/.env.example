# =============================================================================
# Committee Manager — OTP Gateway  •  Environment Variables
# =============================================================================
# Copy this file to .env and fill in REAL values.
# NEVER commit .env to git.  All secrets live here, not in code.
# On Render.com set these in Dashboard → Your Service → Environment.
# =============================================================================

# --- Server ------------------------------------------------------------------
# Render injects PORT automatically; leave blank locally to default to 4000.
PORT=4000
NODE_ENV=production

# --- Security ----------------------------------------------------------------
# A long random string used as the HMAC key for OTP hashing.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=REPLACE_WITH_64_CHAR_HEX_STRING

# Shared secret the Flutter app sends in the x-otp-key header.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Leave blank only in local dev (disables the check).
OTP_API_KEY=REPLACE_WITH_STRONG_RANDOM_KEY

# --- OTP policy (optional — sensible defaults shown) -------------------------
OTP_VALIDITY_MINUTES=5
OTP_MAX_ATTEMPTS=5

# --- Email delivery ----------------------------------------------------------
# Gmail app password setup:
#   1. myaccount.google.com → Security → 2-Step Verification → ON
#   2. myaccount.google.com → Security → App passwords → create one
#   3. Paste the 16-char password (no spaces) below.
MAIL_SERVICE=gmail
MAIL_USER=your.address@gmail.com
MAIL_PASS=your-16-char-app-password
MAIL_FROM="Committee Manager <your.address@gmail.com>"

# Custom SMTP (leave MAIL_SERVICE blank and fill these in instead of gmail):
# MAIL_SERVICE=
# MAIL_HOST=smtp.mailgun.org
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USER=postmaster@mg.yourdomain.com
# MAIL_PASS=your-mailgun-password

# --- CORS (optional) ---------------------------------------------------------
# Comma-separated origins allowed to call the API.
# A Flutter mobile app sends NO Origin header so * works fine.
ALLOWED_ORIGINS=*

# --- Branding ----------------------------------------------------------------
APP_NAME=Committee Manager

# --- MongoDB cloud backup ----------------------------------------------------
# Keep this only in the backend .env file. Never put it in Flutter or commit it.
# Use a newly rotated credential before enabling cloud sync.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/
MONGODB_DATABASE=committee_manager

# HMAC key used to sign cloud-sync access tokens.
SYNC_SECRET=REPLACE_WITH_64_CHAR_HEX_STRING
